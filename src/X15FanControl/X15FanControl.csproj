<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>X15FanControl</AssemblyName>
    <RootNamespace>X15FanControl</RootNamespace>
    <ApplicationIcon>Assets\x15-fan-control.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>X15FanControl.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\X15FanCore\X15FanCore.csproj" />
    <ProjectReference Include="..\X15XtuBridge\X15XtuBridge.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\vendor\ClevoEcInfo.dll" Link="ClevoEcInfo.dll" Condition="Exists('..\..\vendor\ClevoEcInfo.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\X15XtuBridge\bin\x64\Release\net48\X15XtuBridge.exe" Link="X15XtuBridge.exe" Condition="Exists('..\X15XtuBridge\bin\x64\Release\net48\X15XtuBridge.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
